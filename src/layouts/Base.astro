---
const {
  title,
  description = "Het's dump ground",
  crumbs = [],
  cover,
  coverPosition = 'center 50%',
  coverCaption
} = Astro.props
const pageTitle = title === "Het's Website" ? title : `${title} · Het's Website`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {
      crumbs.length > 0 && (
        <header>
          <nav>
            <a href="/" class="home-link">Home</a>
            {crumbs.map((c) => (
              <span class="crumb">
                / {c.href ? <a href={c.href}>{c.label}</a> : c.label}
              </span>
            ))}
          </nav>
        </header>
      )
    }

    {
      cover && (
        <figure class="cover-wrap">
          <img
            class="page-cover"
            src={cover}
            alt=""
            style={`object-position: ${coverPosition}`}
          />
          {coverCaption && <figcaption class="cover-caption">{coverCaption}</figcaption>}
        </figure>
      )
    }

    <main>
      <slot />
    </main>

    <style is:global>
      :root {
        --bg: #191919;
        --fg: #d4d4d4;
        --muted: #9b9b9b;
        --line: #2f2f2f;
        --accent: #529cca;
        --card: #202020;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; color-scheme: dark; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI',
          Helvetica, 'Apple Color Emoji', Arial, sans-serif, 'Segoe UI Emoji',
          'Segoe UI Symbol';
        line-height: 1.6;
        font-size: 16px;
      }
      header {
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
      }
      nav { display: flex; gap: 0.5ch; flex-wrap: wrap; align-items: baseline; }
      .home-link { font-weight: 600; color: var(--fg); text-decoration: none; }
      .crumb { color: var(--muted); }
      .crumb a { color: var(--muted); }
      .crumb a:hover { color: var(--fg); text-decoration: none; }

      .cover-wrap { position: relative; margin: 0; }
      .page-cover {
        display: block;
        width: 100%;
        height: 30vh;
        min-height: 200px;
        max-height: 400px;
        object-fit: cover;
      }
      .cover-caption {
        position: absolute;
        right: 12px;
        bottom: 10px;
        font-size: 0.7rem;
        color: #fff;
        background: rgba(0, 0, 0, 0.45);
        padding: 2px 8px;
        border-radius: 4px;
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
      }
      .cover-wrap:hover .cover-caption { opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        .cover-caption { transition: none; }
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
      }
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.15;
        margin: 1.25rem 0 1.5rem;
        text-wrap: balance;
      }
      h2 { font-size: 1.45rem; margin: 2.5rem 0 0.5rem; letter-spacing: -0.005em; }
      h3 { font-size: 1.15rem; margin: 1.5rem 0 0.25rem; }
      p { margin: 0.7rem 0; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      ul { padding-left: 1.4rem; }
      li { margin: 0.3rem 0; }
      hr { border: none; border-top: 1px solid var(--line); margin: 2rem 0; }
      blockquote {
        margin: 1rem 0;
        padding: 0.25rem 1rem;
        border-left: 3px solid var(--line);
        color: var(--muted);
      }
      .muted { color: var(--muted); }

      details.section { margin: 0.75rem 0; }
      details.section summary {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
        list-style: none;
        padding: 0.4rem 0.5rem;
        margin: 0 -0.5rem;
        border-radius: 4px;
        user-select: none;
      }
      details.section summary::-webkit-details-marker { display: none; }
      details.section summary:hover { background: var(--card); }
      details.section summary h2 { margin: 0; }
      .chev {
        color: var(--muted);
        font-size: 0.95rem;
        transition: transform 0.15s ease;
      }
      details[open] .chev { transform: rotate(90deg); }
      @media (prefers-reduced-motion: reduce) {
        .chev { transition: none; }
      }
      .section-body { padding: 0.25rem 0 0.5rem 1.7rem; }
      .section-body > p:first-child { margin-top: 0.25rem; }

      .updated {
        color: var(--muted);
        font-size: 0.85rem;
        margin: -0.9rem 0 1.75rem;
      }

      .page-list { list-style: none; padding: 0; margin: 0.5rem 0; }
      .page-list li { margin: 0.4rem 0; }

      .arrow-link {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-color: var(--muted);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }
      .arrow-link::after {
        content: ' ↗';
        font-size: 0.75em;
        color: var(--muted);
        text-decoration: none;
        display: inline-block;
      }
      .arrow-link:hover {
        text-decoration: underline;
        text-decoration-color: var(--fg);
      }
      .arrow-link:hover::after { color: var(--fg); }

      .media-list {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 1rem;
      }
      .media-list li { margin: 0.35rem 0; }

      .contact-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1rem 0;
        justify-content: center;
      }
      .contact-row a {
        padding: 0.3rem 0.9rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--fg);
        font-size: 0.95rem;
      }
      .contact-row a:hover {
        text-decoration: none;
        border-color: var(--accent);
        color: var(--accent);
      }
    </style>
  </body>
</html>
