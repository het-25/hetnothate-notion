---
const { title, description = "Het's dump ground", crumbs = [], cover } = Astro.props
const pageTitle = title === "Het's Website" ? title : `${title} · Het's Website`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      const saved = localStorage.getItem('theme')
      if (saved) document.documentElement.dataset.theme = saved
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="site-name">Het’s Website</a>
        {
          crumbs.map((c) => (
            <span class="crumb">
              / {c.href ? <a href={c.href}>{c.label}</a> : c.label}
            </span>
          ))
        }
      </nav>
      <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
    </header>

    {cover && <img class="page-cover" src={cover} alt="" />}

    <main>
      <slot />
    </main>

    <footer>© {new Date().getFullYear()} Het</footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement
        const dark = matchMedia('(prefers-color-scheme: dark)').matches
        const current = root.dataset.theme || (dark ? 'dark' : 'light')
        const next = current === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('theme', next)
      })
    </script>

    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #37352f;
        --muted: #787774;
        --line: #e9e9e7;
        --accent: #0b6e99;
        --card: #f7f6f3;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #191919;
          --fg: #d4d4d4;
          --muted: #9b9b9b;
          --line: #2f2f2f;
          --accent: #529cca;
          --card: #202020;
        }
      }
      :root[data-theme='dark'] {
        --bg: #191919;
        --fg: #d4d4d4;
        --muted: #9b9b9b;
        --line: #2f2f2f;
        --accent: #529cca;
        --card: #202020;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI',
          Helvetica, 'Apple Color Emoji', Arial, sans-serif, 'Segoe UI Emoji',
          'Segoe UI Symbol';
        line-height: 1.6;
        font-size: 16px;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
      }
      nav { display: flex; gap: 0.5ch; flex-wrap: wrap; align-items: baseline; }
      .site-name { font-weight: 600; color: var(--fg); text-decoration: none; }
      .crumb { color: var(--muted); }
      .crumb a { color: var(--muted); }
      .crumb a:hover { color: var(--fg); text-decoration: none; }
      #theme-toggle {
        background: none;
        border: none;
        color: var(--muted);
        font-size: 1.1rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
      }
      #theme-toggle:hover { color: var(--fg); }

      .page-cover {
        display: block;
        width: 100%;
        height: 30vh;
        min-height: 180px;
        max-height: 340px;
        object-fit: cover;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
      }
      h1 { font-size: 2.2rem; line-height: 1.2; margin: 1rem 0 1.25rem; }
      h2 { font-size: 1.35rem; margin: 2.25rem 0 0.5rem; }
      h3 { font-size: 1.1rem; margin: 1.5rem 0 0.25rem; }
      p { margin: 0.6rem 0; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      ul { padding-left: 1.4rem; }
      li { margin: 0.3rem 0; }
      hr { border: none; border-top: 1px solid var(--line); margin: 2rem 0; }
      blockquote {
        margin: 1rem 0;
        padding: 0.25rem 1rem;
        border-left: 3px solid var(--line);
        color: var(--muted);
      }
      .muted { color: var(--muted); }

      .page-list { list-style: none; padding: 0; }
      .page-list li { margin: 0.35rem 0; }
      .page-list a {
        color: var(--fg);
        border-bottom: 1px solid var(--line);
      }
      .page-list a:hover { text-decoration: none; border-color: var(--fg); }
      .doc { color: var(--muted); margin-right: 0.4ch; }

      .contact-row { display: flex; flex-wrap: wrap; gap: 1.25rem; margin: 0.75rem 0; }

      footer {
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem 2.5rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
